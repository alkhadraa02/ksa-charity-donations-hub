# Copy this file to .env before running the project.

# SQLite database file (relative to the prisma/ folder). It is gitignored.
DATABASE_URL="file:./dev.db"

# Admin account created by `npm run db:seed`.
# These are DEFAULTS FOR LOCAL DEVELOPMENT ONLY - change them for any real deployment.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe-Admin-2026"

# Public site settings
NEXT_PUBLIC_SITE_URL="http://localhost:3110"
NEXT_PUBLIC_ORG_NAME="جمعية بذل الخيرية"

# Set to "true" when the site is served over HTTPS so the session cookie is Secure.
COOKIE_SECURE="false"
