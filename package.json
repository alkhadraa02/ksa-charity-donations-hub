{
  "name": "charity-campaigns-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Charity campaigns and donations platform with admin dashboard (Arabic RTL)",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3110",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:setup": "prisma db push --skip-generate && npm run db:seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "vitest": "5.0.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
